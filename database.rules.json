{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['c','m','p','s'])",
        "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0" },
        "p": { ".validate": "newData.isString() && newData.val().matches(/^(stand|walk|lean|sit|hapjang|bow|bow108|light)$/)" },
        "pt": { ".validate": "newData.isNumber()" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
        "h": { ".validate": "newData.isString() && newData.val().matches(/^(m|f)$/)" },
        "s": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "m": {
          ".validate": "newData.hasChildren(['fx','fz','tx','tz','t'])",
          "fx": { ".validate": "newData.isNumber()" },
          "fz": { ".validate": "newData.isNumber()" },
          "tx": { ".validate": "newData.isNumber()" },
          "tz": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "g": {
          ".validate": "newData.hasChildren(['to','at'])",
          "to": { ".validate": "newData.isString() && newData.val().length < 64" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "traces": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 7200000)",
        ".validate": "newData.hasChildren(['x','z','k','at'])",
        "x": { ".validate": "newData.isNumber()" },
        "z": { ".validate": "newData.isNumber()" },
        "k": { ".validate": "newData.isString() && newData.val().matches(/^(step|lean)$/)" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "candles": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 90000000)",
        ".validate": "newData.hasChildren(['slot','n','at'])",
        "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 48 && newData.val() % 1 === 0" },
        "h": { ".validate": "newData.isString() && newData.val().matches(/^(m|f)$/)" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "visits": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || data.child('at').val() < now - 7200000)",
        ".validate": "newData.hasChildren(['at'])",
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    }
  }
}
