{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['c','m','p','s'])",
        "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0" },
        "p": { ".validate": "newData.isString() && newData.val().matches(/^(stand|walk|lean|sit|hapjang|bow|bow108|light|give)$/)" },
        "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0" },
        "pt": { ".validate": "newData.isNumber()" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
        "h": { ".validate": "newData.isString() && newData.val().matches(/^(m|f)$/)" },
        "s": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "m": {
          ".validate": "newData.hasChildren(['fx','fz','tx','tz','t'])",
          "fx": { ".validate": "newData.isNumber()" },
          "fz": { ".validate": "newData.isNumber()" },
          "tx": { ".validate": "newData.isNumber()" },
          "tz": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "g": {
          ".validate": "newData.hasChildren(['to','at'])",
          "to": { ".validate": "newData.isString() && newData.val().length < 64" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "traces": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 7200000)",
        ".validate": "newData.hasChildren(['x','z','k','at'])",
        "x": { ".validate": "newData.isNumber()" },
        "z": { ".validate": "newData.isNumber()" },
        "k": { ".validate": "newData.isString() && newData.val().matches(/^(step|lean)$/)" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "offers": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 90000000)",
        ".validate": "newData.hasChildren(['k','slot','n','at'])",
        "k": { ".validate": "newData.isString() && newData.val().matches(/^(hall|herm|cave|gwan)$/)" },
        "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24 && newData.val() % 1 === 0" },
        "h": { ".validate": "newData.isString() && newData.val().matches(/^(m|f)$/)" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "candles": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 90000000)",
        ".validate": "newData.hasChildren(['slot','n','at'])",
        "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 48 && newData.val() % 1 === 0" },
        "h": { ".validate": "newData.isString() && newData.val().matches(/^(m|f)$/)" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "wishes": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 608400000)",
        ".validate": "newData.hasChildren(['slot','at']) && (newData.hasChild('t') ? !newData.hasChild('n') && !newData.hasChild('h') : newData.hasChild('n'))",
        "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 60 && newData.val() % 1 === 0" },
        "t": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().matches(/.*([0-9]|[０-９]|[Hh][Tt][Tt][Pp]|[Ww][Ww][Ww]|@|[.][A-Za-z]).*/)" },
        "h": { ".validate": "newData.isString() && newData.val().matches(/^(m|f)$/)" },
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "wishJoins": {
      ".read": "auth != null",
      "$wid": {
        ".write": "auth != null && !newData.exists() && !root.child('wishes/' + $wid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('wishes/' + $wid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "notes": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists() && (!root.child('noteLast/' + auth.uid).exists() || root.child('noteLast/' + auth.uid).val() < now - 60000)",
        ".validate": "newData.hasChildren(['t','at'])",
        "t": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "noteLast": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000"
      }
    },
    "visits": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || data.child('at').val() < now - 7200000)",
        ".validate": "newData.hasChildren(['at'])",
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    }
  }
}
